---
// Bism Supported Living — phiên bản tiếng Việt (bản nháp phần đầu trang/menu/chân trang; các phần khác vẫn bằng tiếng Anh, chờ dịch)
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#7d8a5e">
  <title>Bism Supported Living · Dịch Vụ Sống Có Hỗ Trợ và Sống Độc Lập tại Quận Los Angeles · Nhà cung cấp được Trung tâm khu vực California cấp giấy phép</title>
  <meta name="description" content="Bism Supported Living, LLC là nhà cung cấp được Trung tâm khu vực California cấp giấy phép, cung cấp Dịch Vụ Sống Có Hỗ Trợ (SLS) và Dịch Vụ Sinh Hoạt Độc Lập (ILS) cho người lớn khuyết tật phát triển tại Quận Los Angeles. Được Trung tâm Khu vực Frank D. Lanterman cấp giấy phép, mã số nhà cung cấp PD4210. Sẵn sàng tiếp nhận khách hàng từ mọi Trung tâm khu vực ở California. Nhân viên nói tiếng Việt, tiếng Anh và tiếng Tây Ban Nha.">
  <link rel="canonical" href="https://bismliving.com/vi/">
  <meta name="author" content="Bism LLC">
  <meta name="robots" content="index, follow">
  <meta property="og:url" content="https://bismliving.com/vi/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Bism Supported Living · Dịch Vụ Sống Có Hỗ Trợ và Sống Độc Lập tại Quận Los Angeles">
  <meta property="og:description" content="Nhà cung cấp được Trung tâm khu vực California cấp giấy phép, cung cấp SLS và ILS cho người lớn khuyết tật phát triển tại Quận LA.">
  <meta property="og:locale" content="vi_VN">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Bism Supported Living · Dịch Vụ Sống Có Hỗ Trợ và Sống Độc Lập tại Quận Los Angeles">
  <meta name="twitter:description" content="Nhà cung cấp được Trung tâm khu vực California cấp giấy phép, cung cấp SLS và ILS cho người lớn khuyết tật phát triển tại Quận LA.">
  <link rel="alternate" hreflang="en" href="https://bismliving.com/">
  <link rel="alternate" hreflang="es" href="https://bismliving.com/es/">
  <link rel="alternate" hreflang="vi" href="https://bismliving.com/vi/">
  <link rel="alternate" hreflang="x-default" href="https://bismliving.com/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    /* ---------- Direction D · Storybook palette ---------- */
    :root {
      --bg:        #f7f1e3;
      --paper:     #fdf9ee;
      --surface:   #ead9b6;
      --deep:      #2d2820;   /* dark band — D's ink */
      --ink:       #2d2820;
      --soft-ink:  #5a5040;
      --accent:    #7d8a5e;
      --accent-deep: #5d6a44;
      --accent-soft: #a8b48a;  /* lightened from D accent for dark-bg use */
      --warm:      #c47a4f;
      --pink:      #d4a190;
      --border:    #d8c8a8;
      --border-soft: #e6dcc0;

      --display: 'Cormorant Garamond', Georgia, serif;
      --body:    'Inter', -apple-system, system-ui, sans-serif;
      --mono:    'JetBrains Mono', ui-monospace, monospace;
    }

    * { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--body);
      font-size: 17px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; cursor: pointer; }
    img { display: block; max-width: 100%; height: auto; }

    .wrap { max-width: 1440px; margin: 0 auto; }

    /* ---------- Header ---------- */
    .nav {
      padding: 28px 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .nav__logo img { height: 90px; width: auto; }
    /* Contained pill — never bleeds past its own box, so it cannot collide
       with the CTA or language toggle when translated labels run longer. */
    .nav__logo, .nav__right { flex-shrink: 0; }
    .nav__links {
      display: flex;
      align-items: center;
      gap: 2px;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 4px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--paper);
      font-size: 15px;
      color: var(--ink);
    }
    .nav__links a {
      text-decoration: none;
      padding: 9px 15px;
      border-radius: 999px;
      white-space: nowrap;
      transition: background 0.2s, color 0.2s;
    }
    .nav__links a:hover { background: var(--surface); color: var(--ink); }
    .nav__right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 12px;
    }
    /* ---------- Language toggle ---------- */
    .nav__lang {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      padding: 3px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--paper);
      font-size: 12px;
      letter-spacing: 0.03em;
    }
    .nav__lang a {
      display: block;
      padding: 5px 13px;
      border-radius: 999px;
      text-decoration: none;
      color: var(--soft-ink);
      white-space: nowrap;
      transition: background 0.2s, color 0.2s;
    }
    .nav__lang a:hover { color: var(--ink); background: var(--surface); }
    .nav__lang a[aria-current="true"] { background: var(--ink); color: var(--bg); }
    .nav__cta {
      background: var(--ink);
      color: var(--bg);
      padding: 12px 22px;
      border-radius: 999px;
      font-size: 14px;
      text-decoration: none;
      letter-spacing: 0.02em;
    }

    /* ---------- Eyebrow ---------- */
    .eyebrow {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-deep);
      margin-bottom: 28px;
    }
    .eyebrow--bar {
      display: inline-flex; align-items: center; gap: 12px;
    }
    .eyebrow--bar::before {
      content: ""; width: 24px; height: 1px; background: currentColor;
      display: inline-block;
    }

    section { padding: 120px 80px; }

    /* ---------- HERO (Direction A copy) ---------- */
    .hero {
      padding: 100px 80px 80px;
    }
    .hero__grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .hero h1 {
      font-family: var(--display);
      font-size: 77px;
      line-height: 1.05;
      font-weight: 400;
      margin: 0;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .hero h1 em {
      color: var(--accent-deep);
      font-style: italic;
    }
    .hero__lead {
      font-size: 21px;
      line-height: 1.55;
      margin-top: 36px;
      max-width: 560px;
      color: var(--ink);
      opacity: 0.78;
    }
    .hero__ctas {
      display: flex; gap: 16px; margin-top: 44px;
    }
    .btn {
      padding: 18px 32px;
      border-radius: 999px;
      font-size: 15px;
      text-decoration: none;
      letter-spacing: 0.02em;
      font-weight: 500;
      display: inline-block;
    }
    .btn--solid {
      background: var(--ink);
      color: var(--bg);
      border: 1px solid var(--ink);
    }
    .btn--ghost {
      border: 1px solid var(--ink);
      color: var(--ink);
    }
    .hero__partners {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      margin-top: 64px;
      padding-top: 28px;
      border-top: 1px solid var(--border);
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--soft-ink);
      opacity: 0.85;
    }

    .hero__photo {
      position: relative;
    }
    .photo {
      aspect-ratio: 4 / 5;
      background:
        repeating-linear-gradient(135deg,
          var(--surface) 0 12px,
          var(--border) 12px 24px);
      color: var(--soft-ink);
      display: flex;
      align-items: flex-end;
      padding: 16px;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-radius: 4px;
    }
    .photo--sage { background: repeating-linear-gradient(135deg, #c9d2b8 0 12px, #bcc7a7 12px 24px); }
    .photo--warm { background: repeating-linear-gradient(135deg, #e8dfd1 0 12px, #ddd1be 12px 24px); }
    .photo--clay { background: repeating-linear-gradient(135deg, #d4b69b 0 12px, #c8a98c 12px 24px); }
    .photo--deep { background: repeating-linear-gradient(135deg, #3a3a35 0 12px, #33332e 12px 24px); color: #aea696; }

    /* Scroll-synced video — overrides .photo placeholder visuals */
    .photo--video {
      background: var(--surface);
      padding: 0;
      display: block;
      width: 100%;
      object-fit: cover;
      border-radius: 4px;
    }
    .hero__photo-video { aspect-ratio: 812 / 1200; height: auto; }
    .careers__photo.photo--video {
      aspect-ratio: auto;
      height: 100%;
      min-height: 520px;
    }
    .areas__map-image {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 4px;
      background: var(--surface);
    }

    .hero__pull {
      position: absolute;
      bottom: -40px;
      left: -40px;
      width: 240px;
      background: var(--paper);
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: 6px;
      box-shadow: 0 24px 48px -28px rgba(45, 40, 32, 0.18);
    }
    .hero__pull img { height: 36px; margin-bottom: 14px; }
    .hero__pull-quote {
      font-family: var(--display);
      font-size: 22px;
      line-height: 1.2;
      font-style: italic;
      color: var(--ink);
    }
    .hero__pull-label {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--soft-ink);
      margin-top: 10px;
    }

    /* ---------- SLS / ILS split (B) ---------- */
    .split {
      padding: 0;
      background: var(--accent);
      color: var(--bg);
    }
    .split__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .split__col {
      padding: 120px 56px;
    }
    .split__col + .split__col {
      border-left: 1px solid rgba(247, 241, 227, 0.22);
    }
    .split__label {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.2em;
      color: var(--bg);
      opacity: 0.75;
      margin-bottom: 28px;
    }
    .split h2 {
      font-family: var(--display);
      font-size: 64px;
      font-weight: 300;
      line-height: 1.02;
      margin: 0;
      color: var(--bg);
      letter-spacing: -0.02em;
    }
    .split p {
      font-size: 17px;
      line-height: 1.65;
      margin-top: 28px;
      color: var(--bg);
      opacity: 0.72;
      max-width: 440px;
    }
    .split ul {
      margin-top: 32px;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 14px;
    }
    .split li {
      padding-left: 24px;
      position: relative;
      color: var(--bg);
      opacity: 0.88;
      font-size: 15px;
    }
    .split li::before {
      content: "";
      position: absolute;
      left: 0; top: 11px;
      width: 12px; height: 1px;
      background: var(--bg);
      opacity: 0.65;
    }

    /* ---------- Approach manifesto (B) ---------- */
    .approach {
      padding: 160px 80px;
    }
    .approach__grid {
      display: grid;
      grid-template-columns: 0.6fr 1.6fr;
      gap: 80px;
      align-items: start;
    }
    .approach__side {
      position: sticky; top: 40px;
    }
    .approach h2 {
      font-family: var(--display);
      font-size: 84px;
      font-weight: 300;
      line-height: 0.98;
      margin: 0;
      letter-spacing: -0.03em;
      max-width: 900px;
    }
    .approach h2 em {
      color: var(--accent);
      font-style: italic;
    }
    .approach__lead {
      font-size: 22px;
      line-height: 1.5;
      margin-top: 40px;
      color: var(--ink);
      opacity: 0.78;
      max-width: 720px;
    }
    .approach__points {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-top: 80px;
    }
    .approach__point {
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }
    .approach__point h3 {
      font-family: var(--display);
      font-size: 28px;
      font-weight: 400;
      margin: 0 0 10px;
      letter-spacing: -0.01em;
    }
    .approach__point p {
      margin: 0;
      font-size: 16px;
      line-height: 1.6;
      color: var(--ink);
      opacity: 0.7;
    }
    /* Floating sticky hearts.
       Two heart zones wrap content vertically:
         heart-zone--top    wraps hero + split, hero-pull heart sticks here
         heart-zone--bottom wraps approach + all following sections, approach heart sticks here
       Each zone has an absolutely-positioned anchor that defines the horizontal
       position; the heart inside is position:sticky so it pins to the viewport
       top offset while its zone is in view, then releases when the zone ends. */
    .heart-zone { position: relative; }
    .heart-zone__anchor {
      position: absolute;
      top: 0;
      height: 100%;
      pointer-events: none;
      z-index: 5;
    }
    .heart-zone__anchor--left {
      left: 80px;
      width: 56px;
    }
    .floating-heart {
      position: sticky;
      width: 100%;
      height: auto;
      display: block;
      opacity: 0.85;
      transition: filter 0.35s ease, opacity 0.2s ease;
      will-change: transform, filter, opacity;
    }
    /* Approach heart starts under the "Our Approach" eyebrow */
    .heart-zone__anchor--left .floating-heart {
      margin-top: 220px;
      top: 100px;
    }
    /* Applied by JS once the heart is close to alignment with the CTA white heart */
    .floating-heart--white {
      filter: brightness(0) invert(1);
    }
    @media (max-width: 1100px) {
      .heart-zone__anchor { display: none; }
    }

    /* ---------- Who we serve (B) ---------- */
    .serve {
      background: var(--surface);
      padding: 140px 80px;
    }
    .serve__grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 80px;
      align-items: start;
    }
    .serve h2 {
      font-family: var(--display);
      font-size: 56px;
      font-weight: 300;
      line-height: 1.02;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .serve p {
      font-size: 17px;
      line-height: 1.65;
      margin-top: 28px;
      opacity: 0.75;
      max-width: 420px;
    }
    .serve__row {
      padding: 28px 0;
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: 60px 1fr auto;
      gap: 24px;
      align-items: center;
    }
    .serve__row:last-child { border-bottom: 1px solid var(--border); }
    .serve__row-num {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--soft-ink);
      letter-spacing: 0.15em;
    }
    .serve__row-text {
      font-family: var(--display);
      font-size: 32px;
      font-weight: 300;
      letter-spacing: -0.01em;
    }
    .serve__row-arrow {
      font-size: 22px;
      color: var(--accent);
    }

    /* ---------- Service Areas (B) ---------- */
    .areas {
      padding: 140px 80px;
    }
    .areas__grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 80px;
      align-items: start;
    }
    .areas__map {
      background: var(--paper);
      padding: 56px;
      border-radius: 4px;
      border: 1px solid var(--border);
    }
    .areas__map-label {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--soft-ink);
      text-align: center;
      margin-top: 24px;
    }
    .areas h2 {
      font-family: var(--display);
      font-size: 52px;
      font-weight: 300;
      line-height: 1.02;
      margin: 0 0 32px;
      letter-spacing: -0.02em;
    }
    .areas__list { display: grid; gap: 14px; }
    .areas__cities {
      margin-top: 34px;
      padding-top: 26px;
      border-top: 1px solid var(--border);
      max-width: 460px;
    }
    .areas__cities-label {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-deep);
      margin-bottom: 12px;
    }
    .areas__cities p {
      margin: 0;
      font-size: 15px;
      line-height: 1.75;
      color: var(--soft-ink);
    }
    .areas__row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }
    .areas__row-name {
      font-family: var(--display);
      font-size: 22px;
      font-weight: 400;
    }
    .areas__row-abbr {
      font-family: var(--mono);
      font-size: 12px;
      color: var(--soft-ink);
      letter-spacing: 0.12em;
    }

    /* ---------- Testimonials (B) ---------- */
    .quotes {
      background: var(--accent);
      color: var(--bg);
      padding: 160px 80px;
    }
    .quotes__label {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.2em;
      color: var(--bg);
      opacity: 0.75;
      margin-bottom: 48px;
      text-transform: uppercase;
    }
    .quotes blockquote {
      margin: 0;
      font-family: var(--display);
      font-size: 72px;
      line-height: 1.08;
      font-weight: 300;
      letter-spacing: -0.02em;
      color: var(--bg);
      max-width: 1200px;
    }
    .quotes blockquote em {
      color: var(--paper);
      font-style: italic;
      opacity: 0.92;
    }
    .quotes__attrib {
      margin-top: 48px;
      font-size: 14px;
      color: var(--bg);
      opacity: 0.6;
      font-family: var(--mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .quotes__small {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      margin-top: 100px;
      padding-top: 60px;
      border-top: 1px solid rgba(247, 241, 227, 0.30);
    }
    .quotes__small p {
      font-family: var(--display);
      font-size: 19px;
      line-height: 1.45;
      font-style: italic;
      font-weight: 300;
      margin: 0;
      opacity: 0.92;
    }
    .quotes__small-name {
      margin-top: 20px;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.12em;
      color: var(--bg);
      opacity: 0.75;
      text-transform: uppercase;
    }

    /* ---------- Careers (B) ---------- */
    .careers {
      padding: 140px 80px;
    }
    .careers__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: stretch;
    }
    .careers__photo { height: 100%; min-height: 520px; aspect-ratio: auto; }
    .careers h2 {
      font-family: var(--display);
      font-size: 64px;
      font-weight: 300;
      line-height: 1.02;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .careers__lead {
      font-size: 18px;
      line-height: 1.6;
      margin-top: 28px;
      margin-bottom: 44px;
      opacity: 0.78;
      max-width: 480px;
    }
    .btn--accent {
      background: var(--accent);
      color: var(--bg);
      border-radius: 4px;
      padding: 18px 32px;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
    }

    /* ---------- Resources (B) ---------- */
    .resources {
      background: var(--surface);
      padding: 140px 80px;
    }
    .resources__head { margin-bottom: 64px; }
    .resources h2 {
      font-family: var(--display);
      font-size: 64px;
      font-weight: 300;
      line-height: 1.02;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .resources__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .resources__card {
      background: var(--paper);
      padding: 28px;
      border-radius: 4px;
      text-decoration: none;
      color: var(--ink);
      border: 1px solid var(--border);
      min-height: 240px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .resources__card-tag {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--soft-ink);
      letter-spacing: 0.15em;
      margin-bottom: 16px;
    }
    .resources__card-title {
      font-family: var(--display);
      font-size: 26px;
      font-weight: 400;
      margin-bottom: 12px;
      line-height: 1.15;
      letter-spacing: -0.01em;
    }
    .resources__card-desc {
      font-size: 14px;
      color: var(--soft-ink);
      line-height: 1.55;
    }
    .resources__card-cta {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.15em;
      color: var(--accent);
      text-transform: uppercase;
      margin-top: 20px;
    }

    /* ---------- FAQ (B) ---------- */
    .faq {
      padding: 140px 80px;
    }
    .faq__grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 80px;
      align-items: start;
    }
    .faq h2 {
      font-family: var(--display);
      font-size: 56px;
      font-weight: 300;
      line-height: 1.02;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .faq__lead {
      font-size: 16px;
      margin-top: 28px;
      color: var(--soft-ink);
      line-height: 1.6;
      max-width: 360px;
    }
    .faq__item {
      border-top: 1px solid var(--border);
      padding: 20px 0;
    }
    .faq__list .faq__item:last-child { border-bottom: 1px solid var(--border); }
    .faq__q {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      cursor: pointer;
      font-size: 19px;
      font-weight: 500;
      line-height: 1.3;
      color: var(--ink);
    }
    .faq__plus {
      font-size: 24px;
      color: var(--accent);
      font-weight: 200;
      transition: transform 0.3s;
      flex-shrink: 0;
    }
    .faq__item[open] .faq__plus { transform: rotate(45deg); }
    .faq__a {
      margin-top: 14px;
      font-size: 16px;
      line-height: 1.65;
      opacity: 0.78;
      max-width: 640px;
    }

    /* ---------- CTA (B) ---------- */
    .cta {
      background: var(--accent);
      color: var(--bg);
      padding: 160px 80px;
    }
    .cta__grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 80px;
      align-items: end;
    }
    .cta img {
      height: 64px;
      filter: brightness(0) invert(1);
    }
    .cta h2 {
      font-family: var(--display);
      font-size: 116px;
      font-weight: 300;
      line-height: 0.96;
      margin: 32px 0 0;
      color: var(--bg);
      letter-spacing: -0.03em;
    }
    .cta__lead {
      font-size: 19px;
      line-height: 1.55;
      color: var(--bg);
      opacity: 0.88;
      margin: 0 0 36px;
    }
    .cta__actions { display: grid; gap: 12px; }
    .cta .btn--solid {
      background: var(--bg);
      color: var(--accent);
      border-radius: 4px;
      padding: 20px 32px;
      font-weight: 600;
      text-align: center;
      border: none;
    }
    .cta .btn--ghost {
      border: 1px solid var(--bg);
      color: var(--bg);
      border-radius: 4px;
      padding: 20px 32px;
      font-weight: 600;
      text-align: center;
    }

    /* ---------- Footer ---------- */
    footer {
      padding: 48px 80px;
      background: var(--deep);
      color: var(--bg);
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 48px;
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      line-height: 1.7;
    }
    footer .footer__col { opacity: 0.78; }
    footer .footer__col--mid { text-align: center; }
    footer .footer__col--right { text-align: right; }
    footer a { color: inherit; text-decoration: underline; text-decoration-color: rgba(247,241,227,0.3); }

    /* ---------- Visually hidden (for SR / LLM crawler content) ---------- */
    .sr-only {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ---------- Modals ---------- */
    dialog.modal {
      border: none;
      padding: 0;
      background: transparent;
      max-width: 680px;
      width: calc(100% - 40px);
      margin: auto;
      color: var(--ink);
    }
    dialog.modal::backdrop {
      background: rgba(45, 40, 32, 0.55);
      backdrop-filter: blur(2px);
    }
    .modal__panel {
      background: var(--paper);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 52px 56px 48px;
      position: relative;
      font-family: var(--body);
      box-shadow: 0 30px 80px -40px rgba(45, 40, 32, 0.45);
    }
    .modal__close {
      position: absolute;
      top: 18px; right: 18px;
      width: 36px; height: 36px;
      border: 1px solid var(--border);
      background: transparent;
      border-radius: 999px;
      cursor: pointer;
      font-size: 22px;
      line-height: 1;
      color: var(--soft-ink);
      display: flex; align-items: center; justify-content: center;
      padding: 0;
    }
    .modal__close:hover { background: var(--bg); }
    .modal__eyebrow {
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent-deep);
      margin-bottom: 18px;
    }
    .modal__title {
      font-family: var(--display);
      font-size: 36px;
      font-weight: 400;
      line-height: 1.1;
      margin: 0 0 12px;
      letter-spacing: -0.01em;
      color: var(--ink);
    }
    .modal__sub {
      font-size: 16px;
      line-height: 1.55;
      color: var(--soft-ink);
      margin: 0 0 28px;
    }
    .modal__body p { margin: 0 0 16px; font-size: 16px; line-height: 1.65; }
    .modal__body h4 {
      font-family: var(--display);
      font-size: 22px;
      font-weight: 400;
      margin: 24px 0 8px;
      letter-spacing: -0.005em;
    }
    .modal__body ul {
      padding-left: 18px;
      margin: 0 0 16px;
    }
    .modal__body li {
      margin-bottom: 6px;
      font-size: 16px;
      line-height: 1.55;
    }

    /* Form */
    .modal__form { display: grid; gap: 16px; }
    .modal__form label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--soft-ink);
    }
    .modal__form input,
    .modal__form textarea {
      font-family: var(--body);
      font-size: 16px;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--bg);
      color: var(--ink);
      outline: none;
      transition: border-color 0.15s;
    }
    .modal__form input:focus,
    .modal__form textarea:focus {
      border-color: var(--accent);
    }
    .modal__form textarea {
      resize: vertical;
      min-height: 130px;
    }
    .modal__form-submit {
      background: var(--ink);
      color: var(--bg);
      border: none;
      border-radius: 999px;
      padding: 16px 32px;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.02em;
      cursor: pointer;
      width: max-content;
      margin-top: 6px;
      font-family: var(--body);
      transition: opacity 0.15s;
    }
    .modal__form-submit:disabled {
      opacity: 0.55;
      cursor: progress;
    }
    /* Honeypot — visually hidden, kept focusable-off so bots auto-fill but humans don't see it */
    .modal__form-honeypot {
      position: absolute;
      left: -9999px;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }
    .modal__form-error {
      font-size: 14px;
      line-height: 1.55;
      color: var(--warm);
      background: rgba(196, 122, 79, 0.10);
      border: 1px solid rgba(196, 122, 79, 0.45);
      padding: 12px 14px;
      border-radius: 4px;
      margin-top: 4px;
    }
    .modal__form-error a {
      color: var(--warm);
      text-decoration: underline;
    }
    .modal__thanks {
      text-align: center;
      padding: 20px 0;
    }
    .modal__thanks h3 {
      font-family: var(--display);
      font-size: 32px;
      font-weight: 400;
      margin: 0 0 12px;
      letter-spacing: -0.01em;
    }
    .modal__thanks p {
      margin: 0;
      color: var(--soft-ink);
    }

    /* Phones: the 3-language pill no longer fits beside the logo, so let the
       header wrap — logo on top, CTA + language toggle right-aligned beneath. */
    @media (max-width: 620px) {
      .nav { flex-wrap: wrap; row-gap: 14px; }
      .nav__logo { flex: 1 1 100%; }
      .nav__right { margin-left: auto; align-items: flex-end; }
    }

    @media (max-width: 700px) {
      .modal__panel { padding: 36px 28px 32px; }
      /* Display type has to come down or a single long word (e.g. the CTA's
         "conversation.") is physically wider than a phone screen. */
      .hero h1 { font-size: 40px; }
      .approach h2 { font-size: 40px; }
      .quotes blockquote { font-size: 30px; }
      .cta h2 { font-size: 42px; }
      .split__col h2 { font-size: 36px; }
      /* 1fr refuses to go below its longest word, shoving the arrow off-screen;
         minmax(0,1fr) lets the text column actually shrink. */
      .serve__row { grid-template-columns: 40px minmax(0, 1fr) auto; gap: 14px; padding: 20px 0; }
      .serve__row-text { font-size: 22px; }
      h1, h2, h3, h4, p, blockquote, li { overflow-wrap: break-word; }
      .split__col { padding: 80px 32px; }
      footer { grid-template-columns: 1fr; gap: 22px; }
      footer .footer__col--mid, footer .footer__col--right { text-align: left; }
      .nav__logo img { height: 64px; }
      .nav__lang { font-size: 11px; }
      .nav__lang a { padding: 5px 9px; }
      .modal__title { font-size: 28px; }
    }

    /* Hide the nav pill once its labels no longer fit beside the logo and CTA.
       Threshold is per-language: measured min width is en 1111 / es 1202 / vi 1152. */
    @media (max-width: 1190px) {
      .nav__links { display: none; }
    }

    /* ---------- Responsive (light pass) ---------- */
    @media (max-width: 1100px) {
      /* section[class] is needed to outrank the per-section class rules
         (.serve/.areas/.quotes/.careers/.resources/.faq/.approach each set
         `padding: Npx 80px`, which beats a bare `section` selector).
         .nav and footer are not sections, so they are named too. */
      .hero, section, section[class], .nav, .cta, footer {
        padding-left: 32px; padding-right: 32px;
      }
      /* grid/flex children default to min-width:auto and refuse to shrink
         below their longest word — which pushed the page wider than the screen. */
      .split__col, .serve__row, .areas__row, .faq__item, .resources__card { min-width: 0; }
      .hero__grid > *, .approach__grid > *, .serve__grid > *, .areas__grid > *,
      .careers__grid > *, .faq__grid > *, .cta__grid > *, .split__grid > *,
      .resources__grid > * { min-width: 0; }
      .hero__grid, .approach__grid, .serve__grid, .areas__grid,
      .careers__grid, .faq__grid, .cta__grid, .split__grid,
      .resources__grid, .quotes__small, .approach__points,
      .careers__stats {
        grid-template-columns: 1fr;
        gap: 48px;
      }
      .hero h1 { font-size: 52px; }
      .approach h2 { font-size: 56px; }
      .quotes blockquote { font-size: 44px; }
      .cta h2 { font-size: 72px; }
      .hero__pull { position: static; width: auto; margin-top: 24px; }
    }
  </style>
</head>
<body>
  <div class="wrap">

    <!-- ===================== NAV ===================== -->
    <header class="nav">
      <div class="nav__logo">
        <a href="/"><img src="/logo/bism-no-subtext.png" alt="Bism" /></a>
      </div>
      <nav class="nav__links">
        <a href="#services">Dịch vụ</a>
        <a href="#approach">Cách làm việc</a>
        <a href="#areas">Khu vực phục vụ</a>
        <a href="#careers">Việc làm</a>
        <a href="#faq">Hỏi đáp</a>
      </nav>
      <div class="nav__right">
        <a class="nav__cta" href="#cta" data-modal="modal-request">Yêu cầu dịch vụ →</a>
        <div class="nav__lang" role="group" aria-label="Ngôn ngữ">
          <a href="/" hreflang="en" lang="en">English</a>
          <a href="/es/" hreflang="es" lang="es">Español</a>
          <a href="/vi/" hreflang="vi" lang="vi" aria-current="true">Tiếng Việt</a>
        </div>
      </div>
    </header>

    <!-- ===================== HERO (Direction A copy) ===================== -->
    <section class="hero">
      <div class="hero__grid">
        <div>
          <div class="eyebrow">Sống Có Hỗ Trợ và Sống Độc Lập · Quận Los Angeles</div>
          <h1>
            Chào mừng<br>
            đến chương tiếp theo.<br>
            <em>Cùng nhau viết</em> nên.
          </h1>
          <p class="hero__lead">
            Bism Supported Living, LLC đồng hành cùng người lớn khuyết tật phát triển ở Quận Los Angeles, xây dựng cuộc sống theo mục tiêu, thói quen và các mối quan hệ của riêng quý vị — với sự chăm sóc luôn lắng nghe trước.
          </p>
          <div class="hero__ctas">
            <a class="btn btn--solid" href="#testimonials">Lời chia sẻ</a>
            <a class="btn btn--ghost" href="#services">SLS / ILS là gì?</a>
          </div>
          <div class="hero__partners">
            <span>Nhà cung cấp được Trung tâm khu vực California cấp giấy phép · Phục vụ người lớn khắp Quận Los Angeles · Có nhân viên nói tiếng Việt</span>
          </div>
        </div>
        <div class="hero__photo">
          <video class="photo photo--video hero__photo-video"
                 data-scroll-video
                 preload="auto" muted playsinline
                 disablepictureinpicture
                 aria-label="Bism — sống có hỗ trợ tại nhà"
                 poster="">
            <source src="/media/hero.mp4" type="video/mp4">
          </video>
          <div class="hero__pull">
            <img src="/logo/bism-heart.png" alt="">
            <div class="hero__pull-quote">«Tận tâm trong chăm sóc.<br>Tiếng nói của quý vị, hành động của chúng tôi.»</div>
            <div class="hero__pull-label">Lời hứa của chúng tôi</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== SLS / ILS SPLIT (Direction B) ===================== -->
    <section class="split" id="services">
      <div class="split__grid">
        <div class="split__col">
          <div class="split__label">SLS — Sống Có Hỗ Trợ</div>
          <h2>Nhà của quý vị,<br>theo cách của quý vị.</h2>
          <p>
            Hỗ trợ riêng cho từng người — lên đến 24 giờ mỗi ngày — ngay tại nhà quý vị đang ở. Chúng tôi giúp những việc quý vị chọn: nấu ăn, đi làm, gặp gỡ bạn bè, và mọi việc khác trong ngày.
          </p>
          <ul>
            <li>Hỗ trợ sinh hoạt hằng ngày</li>
            <li>Phối hợp về hành vi và y tế</li>
            <li>Hòa nhập cộng đồng</li>
            <li>Tìm người ở chung phù hợp</li>
          </ul>
        </div>
        <div class="split__col">
          <div class="split__label">ILS — Sinh Hoạt Độc Lập</div>
          <h2>Kỹ năng cho<br>chặng đường dài.</h2>
          <p>
            Hướng dẫn bắt đầu từ chỗ mỗi người đang đứng — rèn kỹ năng thật trong hoàn cảnh thật. Chúng tôi đi theo nhịp của quý vị, không phải nhịp của chúng tôi.
          </p>
          <ul>
            <li>Tiền bạc và chi tiêu</li>
            <li>Đi lại và di chuyển</li>
            <li>Tự bênh vực cho mình</li>
            <li>Sức khỏe và chăm sóc y tế</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===================== APPROACH + REMAINING SECTIONS (bottom heart zone) ===================== -->
    <div class="heart-zone heart-zone--bottom">
      <div class="heart-zone__anchor heart-zone__anchor--left">
        <img class="floating-heart" src="/logo/bism-heart.png" alt="" aria-hidden="true">
      </div>

    <!-- ===================== APPROACH MANIFESTO (Direction B) ===================== -->
    <section class="approach" id="approach">
      <div class="approach__grid">
        <div class="approach__side">
          <div class="eyebrow">Cách chúng tôi làm việc</div>
        </div>
        <div>
          <h2>Chúng tôi hỗ trợ — <em>không áp đặt.</em></h2>
          <p class="approach__lead">
            Kế hoạch riêng cho từng người, với chúng tôi, không phải là một khẩu hiệu — đó là cách dựng nên từng kế hoạch, từng lần ghép người, từng lần bàn giao ca. Người chúng tôi phục vụ mới là người viết nên câu chuyện. Chúng tôi chỉ là bàn tay vững vàng giữ lấy trang giấy.
          </p>
          <div class="approach__points">
            <div class="approach__point">
              <h3>Bền bỉ hơn là mở rộng.</h3>
              <p>Chúng tôi phát triển chậm để nhân viên gắn bó đủ lâu, đủ hiểu người mà họ hỗ trợ.</p>
            </div>
            <div class="approach__point">
              <h3>Hiểu hoàn cảnh riêng, ngay từ đầu.</h3>
              <p>Mọi nhân viên đều được huấn luyện để hiểu hoàn cảnh riêng của từng người trước khi bắt tay vào việc — đó là điều căn bản, không phải một chuyên môn riêng.</p>
            </div>
            <div class="approach__point">
              <h3>Gia đình là người đồng hành.</h3>
              <p>Chúng tôi trao đổi cởi mở với gia đình và người thân, không bao giờ làm sau lưng họ.</p>
            </div>
            <div class="approach__point">
              <h3>Tôn trọng ranh giới.</h3>
              <p>Nhu cầu giác quan, cách giao tiếp và nếp sinh hoạt riêng đều được tôn trọng, không thương lượng.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== WHO WE SERVE (Direction B) ===================== -->
    <section class="serve">
      <div class="serve__grid">
        <div>
          <div class="eyebrow">Chúng tôi phục vụ ai</div>
          <h2>Những người lớn có câu chuyện không đi theo đường thẳng.</h2>
          <p>
            Chúng tôi phục vụ người lớn (từ 18 tuổi) đang nhận dịch vụ của một Trung tâm khu vực California — những người khuyết tật phát triển, kể cả người trong phổ tự kỷ và người khuyết tật trí tuệ.
          </p>
        </div>
        <div>
          <div class="serve__row">
            <div class="serve__row-num">/01</div>
            <div class="serve__row-text">Sinh hoạt độc lập với hỗ trợ hằng ngày</div>
            <div class="serve__row-arrow">→</div>
          </div>
          <div class="serve__row">
            <div class="serve__row-num">/02</div>
            <div class="serve__row-text">Chuyển từ nhà gia đình ra ở riêng</div>
            <div class="serve__row-arrow">→</div>
          </div>
          <div class="serve__row">
            <div class="serve__row-num">/03</div>
            <div class="serve__row-text">Rời nhà tập thể để tự lập hơn</div>
            <div class="serve__row-arrow">→</div>
          </div>
          <div class="serve__row">
            <div class="serve__row-num">/04</div>
            <div class="serve__row-text">Đáp ứng nhu cầu phức tạp với chăm sóc 24 giờ</div>
            <div class="serve__row-arrow">→</div>
          </div>
          <div class="serve__row">
            <div class="serve__row-num">/05</div>
            <div class="serve__row-text">Rèn kỹ năng trước một bước chuyển đã định</div>
            <div class="serve__row-arrow">→</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== SERVICE AREAS (Direction B) ===================== -->
    <section class="areas" id="areas">
      <div class="areas__grid">
        <div class="areas__map">
          <img class="areas__map-image" src="/media/map.png"
               alt="Bản đồ các Trung tâm khu vực ở Los Angeles — North LA County, San Gabriel/Pomona, Westside, Lanterman, Eastern LA, South Central LA, Harbor"
               loading="lazy" decoding="async">
          <div class="areas__map-label">Các Trung tâm khu vực ở Los Angeles</div>
        </div>
        <div>
          <div class="eyebrow">Nơi chúng tôi phục vụ</div>
