  <!-- ============================================================
       Modal behavior
       ============================================================ -->
  <script>
    (function () {
      document.addEventListener('click', function (e) {
        // Trigger
        var trigger = e.target.closest('[data-modal]');
        if (trigger) {
          e.preventDefault();
          var dlg = document.getElementById(trigger.dataset.modal);
          if (dlg && typeof dlg.showModal === 'function') dlg.showModal();
          return;
        }
        // Click on backdrop (the dialog element itself, not its content)
        if (e.target.tagName === 'DIALOG') {
          e.target.close();
          return;
        }
        // Explicit close button
        if (e.target.classList && e.target.classList.contains('modal__close')) {
          var d = e.target.closest('dialog');
          if (d) d.close();
        }
      });

      // Request form: POST to /api/contact (Cloudflare Pages Function → Resend)
      var form = document.getElementById('request-form');
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          submitRequestForm(form);
        });
      }

      function submitRequestForm(form) {
        var submitBtn = form.querySelector('button[type="submit"]');
        var originalLabel = submitBtn.textContent;
        var oldError = form.querySelector('.modal__form-error');
        if (oldError) oldError.remove();

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';

        var payload = {
          name:    form.elements.namedItem('name').value,
          email:   form.elements.namedItem('email').value,
          phone:   form.elements.namedItem('phone').value,
          body:    form.elements.namedItem('body').value,
          website: form.elements.namedItem('website').value
        };

        fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(function (res) {
          return res.json().then(function (data) {
            return { ok: res.ok, data: data };
          }).catch(function () {
            return { ok: res.ok, data: {} };
          });
        })
        .then(function (result) {
          if (result.ok) {
            showThanks(form);
          } else {
            showFormError(form, submitBtn, originalLabel, result.data && result.data.error);
          }
        })
        .catch(function () {
          showFormError(form, submitBtn, originalLabel, null);
        });
      }

      function showThanks(form) {
        var panel = form.closest('.modal__panel');
        panel.innerHTML =
          '<button class="modal__close" type="button" aria-label="Đóng">×</button>' +
          '<div class="modal__thanks">' +
            '<h3>Thanks — we received your note.</h3>' +
            '<p>We will reply within one business day.</p>' +
          '</div>';
      }

      function showFormError(form, submitBtn, originalLabel, message) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalLabel;

        var msg = message ||
          'Something went wrong sending your message. ' +
          'Please call (207) 518-1374 or email info@bismliving.com directly.';

        var err = document.createElement('div');
        err.className = 'modal__form-error';
        err.setAttribute('role', 'alert');
        err.innerHTML =
          msg.replace(
            /\(207\) 518-1374/,
            '<a href="tel:+12075181374">(207) 518-1374</a>'
          ).replace(
            /info@bismliving\.com/,
            '<a href="mailto:info@bismliving.com">info@bismliving.com</a>'
          );
        form.appendChild(err);
      }
    })();
  </script>

  <!-- ============================================================
       Scroll-synced video playback
       Each <video data-scroll-video> seeks its currentTime in proportion
       to how far it has traversed the viewport. All-keyframe MP4 encoding
       makes the seek stutter-free.
       ============================================================ -->
  <script>
    (function () {
      var videos = Array.prototype.slice.call(
        document.querySelectorAll('video[data-scroll-video]')
      );
      if (!videos.length) return;

      var rafId = null;
      var pending = true;

      function syncAll() {
        rafId = null;
        if (!pending) return;
        pending = false;

        var vh = window.innerHeight;
        for (var i = 0; i < videos.length; i++) {
          var v = videos[i];
          if (!isFinite(v.duration) || v.duration <= 0) continue;
          var rect = v.getBoundingClientRect();
          // 0 when top edge first touches bottom of viewport,
          // 1 when bottom edge clears top of viewport.
          var travel = vh + rect.height;
          var passed = vh - rect.top;
          var p = passed / travel;
          if (p < 0) p = 0;
          else if (p > 1) p = 1;
          var target = p * v.duration;
          if (Math.abs(v.currentTime - target) > 0.008) {
            try { v.currentTime = target; } catch (_) {}
          }
        }
      }

      function schedule() {
        pending = true;
        if (rafId == null) rafId = requestAnimationFrame(syncAll);
      }

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });

      videos.forEach(function (v) {
        v.addEventListener('loadedmetadata', schedule);
        v.addEventListener('canplay', schedule);
        // Some browsers won't allow seek until first .load() interaction.
        // preload="auto" handles most; explicit kick for the rest.
        try { v.load(); } catch (_) {}
      });

      // Initial frame after layout settles
      requestAnimationFrame(schedule);
    })();
  </script>

  <!-- ============================================================
       Floating heart → CTA white heart merge animation.
       As the CTA section enters the viewport, translate the sticky
       sage heart toward the CTA's white heart position, fade to
       white, and dissolve at full alignment.
       ============================================================ -->
  <script>
    (function () {
      var floatingHeart = document.querySelector('.heart-zone__anchor--left .floating-heart');
      var ctaHeart = document.querySelector('.cta__heart');
      var wrap = document.querySelector('.wrap');
      if (!floatingHeart || !ctaHeart || !wrap) return;

      var STICKY_TOP_OFFSET = 100;   // matches CSS .heart-zone__anchor--left .floating-heart { top: 100px }
      var ANCHOR_LEFT_OFFSET = 80;   // matches CSS .heart-zone__anchor--left { left: 80px }

      // Alignment target = the CTA heart's natural viewport position at max scroll.
      // Recomputed on load + resize so the merge is always reachable, even on
      // tall viewports / short pages where the CTA heart can't reach the sticky
      // pin position before scroll bottoms out.
      var alignmentY = STICKY_TOP_OFFSET;
      function computeAlignmentY() {
        var rect = ctaHeart.getBoundingClientRect();
        var docY = rect.top + window.scrollY;
        var maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
        // Clamp so we never expect alignment above the sticky pin or off-screen
        alignmentY = Math.max(STICKY_TOP_OFFSET, Math.min(window.innerHeight * 0.55, docY - maxScroll));
      }

      var rafId = null;
      var pending = false;

      function update() {
        rafId = null;
        if (!pending) return;
        pending = false;

        // Skip if the floating heart is hidden (mobile)
        if (floatingHeart.offsetParent === null) {
          floatingHeart.style.transform = '';
          floatingHeart.style.opacity = '';
          floatingHeart.classList.remove('floating-heart--white');
          return;
        }

        var ctaHeartRect = ctaHeart.getBoundingClientRect();
        var wrapRect = wrap.getBoundingClientRect();
        var wh = window.innerHeight;

        // The floating heart's natural sticky position in viewport coordinates:
        var stickyLeft = wrapRect.left + ANCHOR_LEFT_OFFSET;
        var stickyTop = STICKY_TOP_OFFSET;

        // Progress: 0 when CTA heart at viewport bottom, 1 when at alignment target
        var progress = 0;
        if (ctaHeartRect.top < wh) {
          if (ctaHeartRect.top > alignmentY) {
            progress = (wh - ctaHeartRect.top) / (wh - alignmentY);
          } else {
            progress = 1;
          }
          if (progress < 0) progress = 0;
          if (progress > 1) progress = 1;
        }

        // Translate floating heart toward CTA white heart
        var dx = ctaHeartRect.left - stickyLeft;
        var dy = ctaHeartRect.top - stickyTop;
        floatingHeart.style.transform = 'translate(' + (dx * progress).toFixed(2) + 'px, ' + (dy * progress).toFixed(2) + 'px)';

        // Color shift to white when close to alignment (CSS transitions filter)
        if (progress > 0.7) {
          floatingHeart.classList.add('floating-heart--white');
        } else {
          floatingHeart.classList.remove('floating-heart--white');
        }

        // Dissolve into the underlying CTA white heart at full alignment
        if (progress > 0.95) {
          var fade = 1 - (progress - 0.95) * 20;  // 1 → 0 over progress 0.95 → 1.0
          floatingHeart.style.opacity = (Math.max(0, fade) * 0.85).toFixed(3);
        } else {
          floatingHeart.style.opacity = '';
        }
      }

      function schedule() {
        pending = true;
        if (rafId == null) rafId = requestAnimationFrame(update);
      }

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', function () { computeAlignmentY(); schedule(); }, { passive: true });
      window.addEventListener('load', function () { computeAlignmentY(); schedule(); });
      computeAlignmentY();
      schedule();
    })();
  </script>

